# Copia este fichero a .env y rellena los valores.
#
#   cp .env.example .env
#
# Secreto para firmar las sesiones. Genera uno propio con:
#   openssl rand -base64 48
# Si lo cambias, todas las sesiones abiertas se cierran.
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio-de-verdad

# Dominio del servidor. Con un dominio real (ratafit.midominio.com) Caddy
# consigue el certificado HTTPS automáticamente. Déjalo como :80 para probar
# por IP en red local.
RATAFIT_DOMAIN=:80

# Solo si sirves la PWA desde otro sitio (por ejemplo GitHub Pages) y quieres
# que apunte a este servidor: https://ratafit.midominio.com
VITE_API_URL=
